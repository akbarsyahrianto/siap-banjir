# ===== Database =====
# PostgreSQL lokal (diinstal langsung di Windows, lihat docs/DECISIONS.md).
DATABASE_URL="postgresql://siapbanjir:siapbanjir@localhost:5432/siapbanjir?schema=public"

# ===== Open-Meteo =====
# Gratis, tanpa API key.
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"

# ===== Web Push (Fase 3) =====
# Buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ===== Cron (Fase 4) =====
# String acak panjang; dikirim sebagai header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ===== Aplikasi =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
